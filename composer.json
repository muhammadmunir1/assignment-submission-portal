{
    "name": "munir/assignment-submission-portal",
    "description": "Assignment Submission Portal for the CSC418 DevOps Lab Mid at COMSATS University Islamabad, Attock Campus. Author: Muhammad Munir | Reg No: CIIT/FA22-BCS-071/ATK",
    "authors": [
        {
            "name": "Muhammad Munir"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8000 -t public"
        ],
        "receiver": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:4000 receiver/receiver.php"
        ],
        "test": "phpunit",
        "report:local": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/report-local.php"
        ],
        "email:preview": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/email-preview.php"
        ]
    }
}
